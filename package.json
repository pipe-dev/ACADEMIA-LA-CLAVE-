{
  "name": "nextn",
  "version": "1.0.41",
  "private": true,
  "scripts": {
    "dev": "node --use-system-ca ./node_modules/next/dist/bin/next dev --turbopack -p 9005",
    "tunnel": "node tunnel.js",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && node scripts/clean-sourcemaps.mjs",
    "cloudflare:build": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && node scripts/clean-sourcemaps.mjs",
    "deploy:worker": "wrangler deploy --no-upload-source-maps --keep-vars",
    "start": "next start",
    "test": "node scratch/test_suite.mjs",
    "test:unit": "npx tsx src/utils/__tests__/pitchUtils.test.ts && npx tsx src/utils/__tests__/livesEngine.test.ts && npx tsx src/components/__tests__/AuraShieldRing.test.ts && npx tsx src/utils/__tests__/vocalNotePool.test.ts && npx tsx src/components/vocal-range/__tests__/vocalRangeUtils.test.ts && npx tsx src/utils/__tests__/vocalRangeHelper.test.ts && npx tsx src/components/breathing/__tests__/breathingEngine.test.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:touch": "node --use-system-ca scratch/test_bottom_nav_first_touch.mjs",
    "test:chaos": "node scripts/chaos-gremlins-playwright.mjs",
    "test:chaos:watch": "node scripts/chaos-gremlins-playwright.mjs --headed"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.6",
    "@tailwindcss/postcss": "^4.3.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "driver.js": "^1.8.0",
    "lucide-react": "^0.475.0",
    "motion": "^13.0.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-youtube": "^10.1.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "gremlins.js": "^2.2.0",
    "playwright": "^1.64.1",
    "postcss": "^8",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "wrangler": "^4.153.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true,
    "unrs-resolver@1.12.2": true
  }
}
