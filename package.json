{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 9005",
    "tunnel": "node tunnel.js",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build && node scripts/clean-sourcemaps.mjs",
    "cloudflare:build": "opennextjs-cloudflare build && node scripts/clean-sourcemaps.mjs",
    "deploy:worker": "wrangler deploy --no-upload-source-maps --keep-vars",
    "start": "next start",
    "test": "node scratch/test_suite.mjs",
    "test:unit": "npx tsx src/utils/__tests__/pitchUtils.test.ts && npx tsx src/utils/__tests__/livesEngine.test.ts && npx tsx src/components/__tests__/AuraShieldRing.test.ts && npx tsx src/utils/__tests__/vocalNotePool.test.ts && npx tsx src/components/vocal-range/__tests__/vocalRangeUtils.test.ts && npx tsx src/utils/__tests__/vocalRangeHelper.test.ts && npx tsx src/components/breathing/__tests__/breathingEngine.test.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.6",
    "@tailwindcss/postcss": "^4.3.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "driver.js": "^1.8.0",
    "lucide-react": "^0.475.0",
    "motion": "^13.0.0",
    "next": "15.3.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-youtube": "^10.1.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.11",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "wrangler": "^4.151.0"
  }
